APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Firebase Auth (backend verifies ID tokens via Google JWKS)
# Firebase Console → Project settings → General → Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Comma-separated origins; regex below covers Flutter web on any local port (dev only).
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|\[::1\]|0\.0\.0\.0)(:\d+)?$

MAX_REQUEST_SIZE_BYTES=2097152
JWT_LEEWAY_SECONDS=30

# Layered rate limits
RATE_LIMIT_PROMPT_BURST=5/minute
RATE_LIMIT_PROMPT_GENERATE=30/hour
RATE_LIMIT_GLOBAL_IP=120/hour

# OpenAPI docs (/docs, /redoc) — disabled automatically when APP_ENV=production
ENABLE_OPENAPI=true
