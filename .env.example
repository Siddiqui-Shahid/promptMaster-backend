APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Supabase Auth (backend verifies access tokens via JWKS)
# Must match the Flutter app's SUPABASE_URL (Project Settings → API → Project URL)
SUPABASE_URL=https://gmpvqdtspyxruunscvpc.supabase.co

# Comma-separated origins; regex below covers Flutter web on any local port.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1|\[::1\]|0\.0\.0\.0)(:\d+)?$

MAX_REQUEST_SIZE_BYTES=2097152
RATE_LIMIT_PROMPT_GENERATE=30/hour
