APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Local development (PostgreSQL on localhost)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/prompt_platform

# Docker Compose overrides DATABASE_URL to use host "postgres" automatically.
POSTGRES_DB=prompt_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

JWT_SECRET=replace-with-strong-secret
JWT_LIFETIME_SECONDS=3600

CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGIN_REGEX=http://(localhost|127\\.0\\.0\\.1)(:\\d+)?$

MAX_REQUEST_SIZE_BYTES=2097152
RATE_LIMIT_PROMPT_GENERATE=10/hour
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_GENERAL=100/minute

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
